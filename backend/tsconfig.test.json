{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "outDir": "./dist",
    "rootDir": ".",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingLInFileNames": true
  },
  "include": ["src/**/*", "../tests/**/*"],
  "exclude": ["node_modules"]
}
